# ==============================================================================
# ROUTEIQ GLOBAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Environments
NODE_ENV=development
ENVIRONMENT=development
PORT=5000

# PostgreSQL + PostGIS Configs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=routeiq_user
POSTGRES_PASSWORD=routeiq_password
POSTGRES_DB=routeiq_db
DATABASE_URL=postgresql://routeiq_user:routeiq_password@localhost:5432/routeiq_db

# MongoDB Configs
MONGO_URI=mongodb://localhost:27017/routeiq
MONGO_URL=mongodb://localhost:27017/routeiq

# Redis Configs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security (JWT Auth & Cookies)
JWT_ACCESS_SECRET=super_secret_access_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_54321
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Microservices URLs
AI_SERVICE_URL=http://localhost:8000
BACKEND_GATEWAY_URL=http://localhost:5000

# External API Keys (Optional - default to mock clients)
MAPBOX_ACCESS_TOKEN=
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_API_KEY=

# Frontend Public Env
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/socket.io
